# Copiar este archivo a .env y rellenar los valores. Nunca versionar el .env.
# En Azure, estas variables se configuran como App Settings del Web App.
# Ver core/config.py para la descripción y los valores por defecto.

# --- Obligatorias -----------------------------------------------------
# Clave de la cookie de sesión (flash messages).
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# Clave para firmar los JWT. Distinta de SECRET_KEY.
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY_AUTH=

# --- Autenticación y CSRF ---------------------------------------------
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# AUTH_COOKIE_SECURE=true
# En producción: ALLOWED_ORIGINS='["https://app.sentinel.world"]'
# ALLOWED_ORIGINS='["http://localhost:8000", "http://127.0.0.1:8000"]'

# --- Base de datos ----------------------------------------------------
# DATABASE_URL=sqlite+aiosqlite:///./database.db
# WORKER_DATABASE_URL=sqlite:///./database.db

# --- Correo -----------------------------------------------------------
# "log" no envía nada (desarrollo); "acs" usa Azure Communication Services.
EMAIL_BACKEND=log
ACS_CONNECTION_STRING=
ACS_SENDER=
# ACS_REPLY_TO=

# --- Celery -----------------------------------------------------------
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_TASK_ALWAYS_EAGER=true
