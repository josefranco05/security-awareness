# Copia este archivo a .env y completa los secretos. Nunca versiones el .env.
# En Azure estas variables salen de Key Vault. Descripción y valores por defecto: core/config.py.

# --- Secretos (obligatorios) ------------------------------------------
# Genera cada uno con: python -c "import secrets; print(secrets.token_hex(32))"
# Cookie de sesión (mensajes flash).
SECRET_KEY=
# Firma de los JWT. Distinta de SECRET_KEY.
SECRET_KEY_AUTH=
# Cabecera X-Webhook-Secret que envía Event Grid. En local no se usa, pero es obligatoria.
ACS_WEBHOOK_SECRET=

# --- Base de datos (docker compose up -d) -----------------------------
# 127.0.0.1, no localhost: en Windows localhost prueba antes ::1 y cada conexión espera al timeout.
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@127.0.0.1:5433/sentinel
WORKER_DATABASE_URL=postgresql+psycopg://sentinel:sentinel@127.0.0.1:5433/sentinel

# --- Celery -----------------------------------------------------------
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# true: los envíos se ejecutan dentro del proceso web, sin worker.
CELERY_TASK_ALWAYS_EAGER=true

# --- Correo -----------------------------------------------------------
# "log" no envía nada; "acs" usa Azure Communication Services.
EMAIL_BACKEND=log
ACS_CONNECTION_STRING=
ACS_SENDER=

# --- Autenticación y CSRF ---------------------------------------------
# false en local: algunos navegadores no guardan una cookie Secure sobre http://.
AUTH_COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000"]
