{
  "manifest_version": 3,
  "name": "Sentinel",
  "version": "0.1.0",
  "description": "Analiza el correo abierto en Gmail u Outlook para detectar phishing.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Analizar este correo",
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ]
}
